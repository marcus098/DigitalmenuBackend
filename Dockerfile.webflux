FROM maven:3.9-eclipse-temurin-17-alpine AS builder
WORKDIR /app

# Only the two modules needed — don't touch the root pom so Maven never
# validates the other <module> entries that aren't copied here.
COPY common/pom.xml common/
COPY webflux-module/pom.xml webflux-module/

# go-offline solo per common. Per webflux lo saltiamo: dipende da common ma
# common non e ancora installato nel .m2 a questo punto, lo step produrebbe
# un [ERROR] cosmetico (vedi Jenkins log-parser false positive). Lo step 8
# (mvn install common && mvn package webflux) scarica cmq le deps mancanti.
RUN mvn dependency:go-offline -B -q -f common/pom.xml 2>/dev/null || true

COPY common/src common/src/
COPY webflux-module/src webflux-module/src/

RUN mvn install -DskipTests -B -q -f common/pom.xml && \
    mvn package -DskipTests -B -q -f webflux-module/pom.xml

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
# Utente non-root
RUN addgroup -S app && adduser -S -G app -H -s /sbin/nologin app
COPY --from=builder /app/webflux-module/target/webflux-module-*.jar app.jar
USER app:app
# Nessun application.properties nell'immagine (vedi .dockerignore): la configurazione arriva a runtime
# via variabili d'ambiente (relaxed binding Spring), es. SPRING_DATASOURCE_URL, SPRING_DATASOURCE_PASSWORD,
# SPRING_DATA_MONGODB_URI, SPRING_KAFKA_BOOTSTRAP_SERVERS, oppure montando un file e usando
# SPRING_CONFIG_ADDITIONAL_LOCATION=/config/ (es. -v ./config:/config:ro).
EXPOSE 8081
ENTRYPOINT ["java", \
  "-XX:+UseContainerSupport", \
  "-XX:MaxRAMPercentage=75.0", \
  "-jar", "app.jar"]
