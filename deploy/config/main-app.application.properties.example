# main-app — configurazione di PRODUZIONE (template).
# Copia in ~/DigitalmenuFrontend/config/main-app/application.properties sul server (chmod 600).
# Il docker-compose la monta in /config/ e la carica con SPRING_CONFIG_ADDITIONAL_LOCATION.
# Le variabili d'ambiente del docker-compose (datasource, mongo, kafka, bucket, chiave di cifratura, URL)
# hanno precedenza su questo file: qui servono soprattutto le chiavi che il compose non passa.
# NON committare mai il file compilato.

spring.application.name=main-app
server.port=8085
# Dietro Caddy: usa X-Forwarded-* per IP reale (rate limit) e schema https
server.forward-headers-strategy=framework

spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.show-sql=false
spring.jpa.hibernate.ddl-auto=update
# Fuso: la JVM gira in Europe/Rome (vedi docs/SERVER_DEPLOY.md). NON impostare hibernate.jdbc.time_zone:
# sposterebbe le colonne LocalDateTime (payments.created_at, takeaway_slot_config.paused_until).

# Sovrascritte dal compose (SPRING_DATASOURCE_*), lasciate per completezza
spring.datasource.url=jdbc:postgresql://postgres:5432/digitalmenu
spring.datasource.username=REPLACE_ME
spring.datasource.password=REPLACE_ME
spring.datasource.driver-class-name=org.postgresql.Driver
jakarta.persistence.jdbc.url=jdbc:postgresql://postgres:5432/digitalmenu

spring.data.mongodb.uri=mongodb://mongodb:27017/digitalmenu
spring.data.mongodb.auto-index-creation=true
spring.data.mongodb.mapping.auto-index-creation=true
spring.data.mongodb.type-mapper.default-type-mapper=org.springframework.data.mongodb.core.convert.DefaultMongoTypeMapper

spring.main.web-application-type=servlet
spring.kafka.bootstrap-servers=kafka:9092

spring.application.imagesPath=/images
spring.application.deletedImagesPath=/deleted
spring.application.separator=/
bucket.images.name=menu
bucket.imagesdeleted.name=menu
bucket.filemanager.name=menu
bucket.filemanagerdeleted.name=menu

# Backblaze B2 (S3) — sovrascritte dal compose (BUCKET_S3_*)
bucket.s3.endpoint=https://s3.eu-central-003.backblazeb2.com
bucket.s3.region=eu-central-003
bucket.s3.accesskey=REPLACE_ME
bucket.s3.secretkey=REPLACE_ME

# DEVE essere identica a quella di webflux (stesso JWT). Genera: openssl rand -base64 64
jwt.application.key=REPLACE_ME
jwt.application.jwt_expiration=86400000
jwt.application.jwt_expiration_check=26400000

# URL pubblici
client.url=https://app.example.com
app.frontend.url=https://app.example.com
app.frontend-base-url=https://app.example.com
app.public-base-url=https://api.example.com
app.cors.allowed-origins=https://app.example.com

# SMTP (Gmail: usa una "password per le app", non la password dell'account)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=REPLACE_ME
spring.mail.password=REPLACE_ME
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.ssl.protocols=TLSv1.2
spring.mail.properties.mail.smtp.ssl.trust=smtp.gmail.com
mail.smtp.ssl.trust=smtp.gmail.com

spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=15MB

# Cifratura delle chiavi di pagamento dei locali (Stripe/SumUp del locale, AES-256-GCM). Vedi docs/PAGAMENTI_SETUP.md
# Base64 di 32 byte: openssl rand -base64 32. Sovrascritta dal compose (APP_SECRETS_ENCRYPTION_KEY).
# BACKUP OBBLIGATORIO: se si perde, tutti i locali devono reinserire le chiavi. Non cambiarla senza ri-cifrare.
app.secrets.encryption-key=REPLACE_ME

# Superadmin della piattaforma: creato all'avvio se entrambe sono impostate e l'email non esiste ancora.
# Sovrascritte dal compose (APP_SUPERADMIN_EMAIL / APP_SUPERADMIN_PASSWORD). Password >= 12 caratteri;
# dopo il primo login svuota la password (non viene mai sovrascritta). Vedi docs/SERVER_DEPLOY.md.
app.superadmin.email=
app.superadmin.password=

# Modulo "Contattaci" del sito vetrina (POST /api/public/contact): indirizzo che riceve le richieste.
# Vuoto = modulo disattivato (l'endpoint risponde 503). Sovrascritta dal compose (APP_CONTACT_TO).
app.contact.to=

# Traduzione del menu in più lingue con Ollama (modello locale, nessun dato inviato a terzi).
# false = la sezione "Lingue del menu" mostra le lingue ma non traduce (le correzioni a mano funzionano comunque).
app.ai.enabled=false
app.ai.ollama.base-url=http://localhost:11434
# Basic auth opzionale se Ollama è dietro un reverse proxy
app.ai.ollama.username=
app.ai.ollama.password=
app.ai.model.translate=qwen2.5:7b
# AxiomAI (riepiloghi, consigli sul menu, descrizioni dei piatti): modello dedicato opzionale.
# Vuoto o commentato = usa lo stesso modello delle traduzioni (app.ai.model.translate).
#app.ai.model.insights=
app.ai.timeout-seconds=120
app.ai.num-ctx=8192

# Notifiche push all'app staff "Sala" (Expo Push API: nuovi ordini dei clienti e prenotazioni). Vedi docs/SERVER_DEPLOY.md.
# false = nessun invio, i messaggi vengono solo loggati ("PUSH (simulazione)"). Il server deve raggiungere https://exp.host.
app.push.enabled=true
# Facoltativo: access token Expo, serve solo se sul progetto Expo è attiva "Enhanced push security".
# Sovrascrivibile da env APP_PUSH_EXPO_ACCESS_TOKEN. Non committare il valore.
app.push.expo-access-token=

twilio.enabled=false
twilio.account-sid=
twilio.auth-token=
twilio.from-number=

esl.ap.default-url=

spring.thymeleaf.prefix=classpath:/templates/emails/
spring.thymeleaf.suffix=.html
spring.thymeleaf.mode=HTML
spring.thymeleaf.cache=true

logging.level.org.springframework.security=INFO

# ── Consegna a domicilio (docs/DOMICILIO.md) ─────────────────────────────────
# Verifica del telefono via SMS con Prelude Verify (https://prelude.so). Chiave SOLO lato server: passala con la
# variabile d'ambiente PRELUDE_API_KEY (docker-compose -> main-app). Vuota = verifica del telefono DISATTIVATA:
# consegna a domicilio e asporto accettano il numero senza codice SMS (viene solo validato).
prelude.api-key=${PRELUDE_API_KEY:}
# false = verifica SMS spenta anche con la chiave impostata (nessun SMS, ordini senza codice). Predefinito true:
# la verifica è attiva solo se gli SMS sono disponibili (chiave Prelude o dev-mode locale).
app.otp.enabled=${APP_OTP_ENABLED:true}
prelude.base-url=https://api.prelude.dev
# Facoltativo: canale preferito (sms, whatsapp, rcs, viber, telegram). Vuoto = instradamento automatico di Prelude.
prelude.preferred-channel=${PRELUDE_PREFERRED_CHANNEL:}
# In produzione SEMPRE false. Anche se impostata a true viene disattivata (ERROR nel log) quando il backend non è
# locale (app.public-base-url non localhost, server.forward-headers-strategy impostato o profilo prod/staging).
app.otp.dev-mode=false
# Segreto HMAC dei phoneToken (90 giorni). Vuoto = derivato da jwt.application.key. Cambiarlo invalida i token.
app.otp.token-secret=
# Limiti anti "SMS pumping" (prima di chiamare Prelude)
app.otp.rate-limit.send.ip.max-attempts=5
app.otp.rate-limit.send.ip.window-minutes=120
app.otp.rate-limit.send.phone.max-attempts=3
app.otp.rate-limit.send.phone.window-minutes=15
app.otp.rate-limit.send.venue.max-per-day=200
app.otp.rate-limit.send.global.max-per-day=2000
app.otp.rate-limit.check.max-attempts=5
app.otp.rate-limit.check.window-minutes=30
# Geocodifica: proxy verso Nominatim (OpenStreetMap), max 1 richiesta/s, con cache. Contatto obbligatorio per la policy.
app.geo.nominatim.base-url=https://nominatim.openstreetmap.org
app.geo.nominatim.contact-email=REPLACE_ME
app.geo.nominatim.user-agent=RestaurantFlow/1.0

# ── Google reCAPTCHA v3 su login e registrazioni ─────────────────────────────
# Chiavi da https://www.google.com/recaptcha/admin (tipo "Basato sul punteggio (v3)"). La site key (pubblica) va nel
# frontend (REACT_APP_RECAPTCHA_SITE_KEY), il secret SOLO qui o con la variabile d'ambiente RECAPTCHA_SECRET.
# Secret vuoto = verifica disattivata (sviluppo locale). Configura sempre ENTRAMBE le chiavi o nessuna: con il secret
# valorizzato e il frontend senza site key, il login dal browser risponde 403.
# Il token arriva nel corpo della richiesta, campo "recaptchaToken" (azioni: login, signup, signup_staff).
# L'app nativa (DineUp Sala) fa login senza token: resta soggetta ai limiti app.login.attempts.* qui sotto.
app.recaptcha.secret=${RECAPTCHA_SECRET:}
# Score minimo (0.0 = bot, 1.0 = umano)
app.recaptcha.min-score=0.5
app.recaptcha.timeout-ms=3000
# Google irraggiungibile (timeout/errore): true = si accetta la richiesta (restano i limiti sui tentativi),
# false = si rifiuta (403). Un secret rifiutato da Google conta come "irraggiungibile" (ERROR nel log).
app.recaptcha.fail-open=true
# Facoltativo: hostname ammessi nel token (es. app.example.com), separati da virgola. Vuoto = nessun controllo.
app.recaptcha.allowed-hostnames=
# Tentativi di login falliti, finestra scorrevole in memoria (per istanza). 0 = regola disattivata.
app.login.attempts.window-minutes=15
# Oltre queste soglie anche le richieste senza browser (app) devono presentare il captcha -> l'app riceve 429
app.login.attempts.captcha-after-ip-failures=5
app.login.attempts.captcha-after-account-failures=5
# Blocco temporaneo (429): per IP sempre; per account solo se la richiesta non ha un captcha valido
app.login.attempts.block-after-ip-failures=30
app.login.attempts.block-after-account-failures=10
